#: ui/threads/autofocus_thread.py
#, python-brace-format
msgid "Auto-focus complete (sharpness {sharpness:.1f}, {passes} coarse pass + fine pass)"
msgid_plural "Auto-focus complete (sharpness {sharpness:.1f}, {passes} coarse passes + fine pass)"
msgstr[0] "Enfoque automático completado (nitidez {sharpness:.1f}, {passes} pasada gruesa + pasada fina)"
msgstr[1] "Enfoque automático completado (nitidez {sharpness:.1f}, {passes} pasadas gruesas + pasada fina)"

#: ui/threads/autofocus_thread.py
