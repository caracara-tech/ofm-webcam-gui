#: core/app_mode.py
msgid "Automated"
msgstr "Automatizado"

#: core/app_mode.py
msgid "Manual"
msgstr "Manual"

#: core/app_mode.py
msgid "Simulation"
msgstr "Simulación"

#: core/app_mode.py
msgid ""
"Full microscope: live camera and motorized stage control. Requires the stage board to be "
"connected."
msgstr ""
"Microscopio completo: cámara en vivo y control de la platina motorizada. Requiere que la placa de"
" la platina esté conectada."

#: core/app_mode.py
msgid "Device without motors: camera preview, snapshots and recording. No stage controls."
msgstr ""
"Dispositivo sin motores: vista previa de la cámara, capturas y grabación. Sin controles de "
"platina."

#: core/app_mode.py
msgid "No hardware needed: full interface with a simulated stage (nothing physical moves)."
msgstr "No requiere hardware: interfaz completa con una platina simulada (no se mueve nada físicamente)."

#. Name of THIS language, written in that language, shown in the language selector (e.g. "Español
#. (Latinoamérica)"). Do not translate literally.
#: core/i18n.py
msgctxt "language name"
msgid "English"
msgstr "Español (Latinoamérica)"

#: hardware/cameras.py
msgid "Camera names need the optional 'pygrabber' package (pip install pygrabber)."
msgstr "Los nombres de las cámaras requieren el paquete opcional 'pygrabber' (pip install pygrabber)."

#: hardware/cameras.py ui/panels/camera_panel.py
#, python-brace-format
msgid "Camera {index}"
msgstr "Cámara {index}"

#: hardware/stage/sangaboard.py
msgid "The 'sangaboard' Python package is not installed (pip install sangaboard)."
msgstr "El paquete de Python 'sangaboard' no está instalado (pip install sangaboard)."

#: hardware/stage/sangaboard.py ui/stage_module.py
msgid "The stage is not connected."
msgstr "La platina no está conectada."

#: hardware/stage/sangaboard.py
#, python-brace-format
msgid ""
"Lost communication with the stage during a move ({error}). Check the USB cable and the board's "
"power."
msgstr ""
"Se perdió la comunicación con la platina durante un movimiento ({error}). Revise el cable USB y "
"la alimentación de la placa."

#: hardware/stage/sangaboard.py
msgid "no response"
msgstr "sin respuesta"

#: hardware/stage/sangaboard.py
#, python-brace-format
msgid "Could not connect to the Sangaboard on {port}."
msgstr "No se pudo conectar con la Sangaboard en {port}."

#: hardware/stage/sangaboard.py
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Motivo: {reason}"

#: hardware/stage/sangaboard.py
msgid "An automatic scan of the other serial ports did not find a Sangaboard either."
msgstr "Una búsqueda automática en los demás puertos seriales tampoco encontró una Sangaboard."

#: hardware/stage/sangaboard.py
msgid ""
"The port exists but could not be opened. Another program may be using it, or your user is not in "
"the 'dialout' group (sudo usermod -aG dialout $USER, then log out and back in)."
msgstr ""
"El puerto existe, pero no se pudo abrir. Es posible que otro programa lo esté usando, o que su "
"usuario no pertenezca al grupo 'dialout' (sudo usermod -aG dialout $USER; luego cierre sesión y "
"vuelva a iniciarla)."

#: hardware/stage/sangaboard.py
msgid "The port exists but could not be opened. Another program may be using it."
msgstr "El puerto existe, pero no se pudo abrir. Es posible que otro programa lo esté usando."

#: hardware/stage/sangaboard.py
msgid "No serial ports were found at all. Is the board plugged in and powered?"
msgstr "No se encontró ningún puerto serial. ¿La placa está conectada y encendida?"

#: hardware/stage/sangaboard.py
#, python-brace-format
msgid "Serial ports visible to this computer: {ports}"
msgstr "Puertos seriales visibles en este equipo: {ports}"

