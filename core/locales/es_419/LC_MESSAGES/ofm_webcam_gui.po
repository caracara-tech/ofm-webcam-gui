#: core/app_mode.py
msgid "Automated"
msgstr "Automatizado"

#: core/app_mode.py
msgid "Manual"
msgstr "Manual"

#: core/app_mode.py
msgid "Simulation"
msgstr "Simulación"

#: core/app_mode.py
msgid ""
"Full microscope: live camera and motorized stage control. If the stage board is not found, its "
"controls stay off until you retry."
msgstr ""
"Microscopio completo: cámara en vivo y control de la plataforma motorizada. Si no se encuentra la "
"placa de la plataforma, sus controles permanecen desactivados hasta que reintente."

#: core/app_mode.py
msgid "Device without motors: camera preview, snapshots and recording. No stage controls."
msgstr ""
"Dispositivo sin motores: vista previa de la cámara, capturas y grabación. Sin controles de "
"plataforma."

#: core/app_mode.py
msgid "No hardware needed: full interface with a simulated stage (nothing physical moves)."
msgstr "No requiere hardware: interfaz completa con una plataforma simulada (no se mueve nada físicamente)."

#. Name of THIS language, written in that language, shown in the language selector (e.g. "Español
