#: ui/threads/autofocus_thread.py
#, python-brace-format
msgid "Auto-focus complete (sharpness {sharpness:.1f}, {passes} coarse pass + fine pass)"
msgid_plural "Auto-focus complete (sharpness {sharpness:.1f}, {passes} coarse passes + fine pass)"
msgstr[0] "Enfoque automático completado (nitidez {sharpness:.1f}, {passes} pasada gruesa + pasada fina)"
msgstr[1] "Enfoque automático completado (nitidez {sharpness:.1f}, {passes} pasadas gruesas + pasada fina)"

#: ui/threads/autofocus_thread.py
msgid "Auto-focus aborted: lost communication with the stage"
msgstr "Enfoque automático interrumpido: se perdió la comunicación con la platina"

#: ui/threads/autofocus_thread.py
#, python-brace-format
msgid "Auto-focus error: {error}"
msgstr "Error de enfoque automático: {error}"

#: ui/threads/camera_thread.py
#, python-brace-format
msgid "Could not open the camera (device index {index}). Try a different device or backend."
msgstr "No se pudo abrir la cámara (índice de dispositivo {index}). Pruebe con otro dispositivo o backend."

#: ui/threads/camera_thread.py
#, python-brace-format
msgid ""
"Camera opened but never delivered a frame at index {index}. It may be in use by another app, or "
"need a different backend."
msgstr ""
"La cámara se abrió, pero nunca entregó un fotograma en el índice {index}. Puede que otra "
"aplicación la esté usando o que necesite un backend diferente."

#: ui/threads/camera_thread.py
msgid "Lost connection to camera (no frame)."
msgstr "Se perdió la conexión con la cámara (sin fotogramas)."

